# Public Firebase web app, all values must belong to ai-discussion-club-260922.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-discussion-club-260922.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-discussion-club-260922
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SITE_URL=

# Server identity. Base64 JSON is rejected unless project_id is ai-discussion-club-260922.
FIREBASE_SERVICE_ACCOUNT_B64=
GCS_UPLOAD_BUCKET=ai-discussion-club-260922-uploads
ADMIN_EMAIL=wzhu1997@gmail.com
ADMIN_PASSWORD=
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# Providers.
LUMA_API_KEY=
LUMA_USER_AGENT=ai-discussion-club/1.0 (+https://aidiscussionclub.com)
EXA_API_KEY=
GOOGLE_VERTEX_PROJECT=ai-discussion-club-260922
GOOGLE_VERTEX_LOCATION=global
RESEND_API_KEY=
# Optional compatibility name during migration. Prefer RESEND_API_KEY.
CLUB_RESEND_API_KEY=
RESEND_CLUB_FROM=AI Discussion Club <hello@aidiscussionclub.com>
# Optional: who gets new demo application notices (defaults to the owner) and the daily cap.
DEMO_NOTIFY_EMAIL=
DEMO_APPLICATION_DAILY_CAP=200

# Keep both off through migration and provider verification.
JOBS_ENABLED=false
EMAIL_SENDING_ENABLED=false

# New events are armed for the T-24h send unless this is "false".
CLUB_AUTOSEND_DEFAULT=true
CLUB_DAILY_EXA_CAP=300
CLUB_DAILY_GEMINI_CAP=800
CLUB_EXA_TTL_DAYS=180
CLUB_MIN_PAIR_SCORE=0.8
CLUB_COOLDOWN_DAYS=120
CLUB_SEND_BATCH=120
CLUB_SEND_EARLIEST_UTC=13

# Public event source: firestore (normal), snapshot (explicit bootstrap only).
PUBLIC_EVENTS_SOURCE=firestore
# Exact origins permitted to update preference sessions.
APP_ALLOWED_ORIGINS=https://ai-discussion-club-psi.vercel.app,https://aidiscussionclub.com,https://www.aidiscussionclub.com
# Fresh, independent PostHog public project token; blank disables analytics.
NEXT_PUBLIC_POSTHOG_KEY=
